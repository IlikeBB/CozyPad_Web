{
  "name": "cozypad-web-tt",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @cozypad/contracts typecheck && pnpm --filter @cozypad/app build",
    "build:connector": "node scripts/build-local-connector.mjs",
    "start": "node apps/server/src/index.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "import:legacy": "node scripts/import-legacy.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "jszip": "^3.10.2",
    "typescript": "^6.0.3"
  }
}
